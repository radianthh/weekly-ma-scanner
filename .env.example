KIWOOM_APP_KEY=your_app_key
KIWOOM_APP_SECRET=your_app_secret
KRX_ID=your_krx_id
KRX_PW=your_krx_password

# 모의투자 키를 사용할 때만 아래 줄의 주석을 해제하세요.
# KIWOOM_BASE_URL=https://mockapi.kiwoom.com

# REPORT_TITLE=주봉 정배열 리포트
# REPORT_LINK_TEXT=
# REPORT_LINK_URL=#

# 메일 발송. MAIL_TO가 비어 있으면 발송을 건너뜁니다.
# 네이버 메일 > 환경설정 > POP3/IMAP 설정에서 "IMAP/SMTP 사용"을 먼저 켜야 합니다.
# 2단계 인증을 켰다면 계정 비밀번호가 아니라 애플리케이션 비밀번호를 넣습니다.
MAIL_TO=수신주소@naver.com
SMTP_USER=네이버아이디
SMTP_PASSWORD=애플리케이션_비밀번호
MAIL_FROM=네이버아이디@naver.com
# SMTP_HOST=smtp.naver.com
# SMTP_PORT=465
# MAIL_FROM_NAME=주봉 정배열 스캐너
# MAIL_ATTACH=1
