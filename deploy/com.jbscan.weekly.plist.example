<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.jbscan.weekly</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/ABSOLUTE/PATH/jbscan/run_weekly.sh</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/jbscan</string>
  <key>StartCalendarInterval</key><dict>
    <key>Weekday</key><integer>5</integer>
    <key>Hour</key><integer>16</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/jbscan/run.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/jbscan/run.log</string>
</dict></plist>
